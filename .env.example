# Generate with: pnpm hash-password '<password>'
APP_USERNAME=
APP_PASSWORD_HASH=
# At least 32 characters each; try `openssl rand -base64 32`
NUXT_SESSION_PASSWORD=
TOKEN_ENCRYPTION_KEY=

# Register <PUBLIC_BASE_URL>/auth/spotify/callback and /auth/tidal/callback in both developer dashboards.
# Development: http://127.0.0.1:4050 (Spotify rejects "localhost").
PUBLIC_BASE_URL=http://127.0.0.1:4050
SPOTIFY_CLIENT_ID=
TIDAL_CLIENT_ID=
# Not used yet: sign-in uses PKCE, which needs only the client ID.
SPOTIFY_CLIENT_SECRET=
TIDAL_CLIENT_SECRET=

# Defaults to ./data/crossfade.db; /config/crossfade.db in Docker.
DATABASE_PATH=
TZ=UTC

# Spotify lookups (ISRC plus fuzzy searches) per sync run before pausing for 30 minutes.
SPOTIFY_LOOKUPS_PER_RUN=150
