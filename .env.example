# M0 spike: both apps use PKCE, so no client secret is needed for the spike.
# Register these redirect URIs in both developer dashboards:
#   http://127.0.0.1:8888/callback/spotify
#   http://127.0.0.1:8888/callback/tidal
SPOTIFY_CLIENT_ID=
TIDAL_CLIENT_ID=

# Dedicated, empty test playlists the spike may write to (M0 only).
SPOTIFY_TEST_PLAYLIST_ID=
TIDAL_TEST_PLAYLIST_ID=

# From M1
PUBLIC_BASE_URL=https://crossfade.example.com
APP_USERNAME=
APP_PASSWORD_HASH=
NUXT_SESSION_PASSWORD=
TOKEN_ENCRYPTION_KEY=
SPOTIFY_CLIENT_SECRET=
TIDAL_CLIENT_SECRET=
TZ=UTC
PUID=99
PGID=100
